        depositAmount = labeledField(form, "Amount to deposit");

        JButton submit = primaryButton("Deposit");
        submit.addActionListener(e -> {
            String accno = depositAccno.getText().trim();
            String amountText = depositAmount.getText().trim();

            if (accno.isEmpty() || amountText.isEmpty()) {
                setStatus("Enter an account number and an amount.");
                return;
            }
            Accounting acc = hm.get(accno);
            if (acc == null) {
                setStatus("Account " + accno + " was not found.");
                return;
            }
            double amount;
            try {
                amount = Double.parseDouble(amountText);
            } catch (NumberFormatException ex) {
                setStatus("Amount must be a number.");
                return;
            }
            if (amount <= 0) {
                setStatus("Amount must be greater than zero.");
                return;
            }

            acc.balance += amount;
            refreshHomeStats();
            depositAmount.setText("");
            setStatus(String.format("Deposited %.2f into account %s. New balance: %.2f",
                    amount, accno, acc.balance));
        });

        JPanel actions = new JPanel(new FlowLayout(FlowLayout.LEFT, 0, 0));
        actions.setBackground(CARD_WHITE);
        actions.setBorder(new EmptyBorder(10, 0, 0, 0));
        actions.add(submit);
