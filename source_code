    private void refreshHomeStats() {
        homeCountValue.setText(String.valueOf(hm.size()));
        double total = 0;
        for (Accounting a : hm.values()) {
            if (a.balance != null) total += a.balance;
        }
        homeBalanceValue.setText(String.format("%.2f", total));
    }

    // ----------------------------------------------------------- CREATE tab

    private JTextField createAccno, createName, createBalance;

    private JPanel buildCreatePanel() {
        JPanel panel = new JPanel();
        panel.setLayout(new BoxLayout(panel, BoxLayout.Y_AXIS));
        panel.setBackground(CANVAS);
        panel.add(sectionHeader("Open Account", "Add a new account to the ledger."));

        JPanel form = formCard();

        createAccno = labeledField(form, "Account number");
        createName = labeledField(form, "Account holder name");
        createBalance = labeledField(form, "Opening balance");

        JButton submit = primaryButton("Open Account");
        submit.addActionListener(e -> {
            String accno = createAccno.getText().trim();
            String name = createName.getText().trim();
            String balanceText = createBalance.getText().trim();

            if (accno.isEmpty() || name.isEmpty() || balanceText.isEmpty()) {
                setStatus("Enter account number, name, and balance before saving.");
                return;
            }
            if (hm.containsKey(accno)) {
                setStatus("Account " + accno + " already exists. Choose a different number.");
                return;
            }
            double balance;
            try {
                balance = Double.parseDouble(balanceText);
            } catch (NumberFormatException ex) {
                setStatus("Balance must be a number.");
                return;
            }

            Accounting acc = new Accounting(accno, name, balance);
            hm.put(accno, acc);
            refreshHomeStats();
            createAccno.setText("");
            createName.setText("");
            createBalance.setText("");
            setStatus("Account opened for " + name + " (No. " + accno + ").");
        });

        JPanel actions = new JPanel(new FlowLayout(FlowLayout.LEFT, 0, 0));
        actions.setBackground(CARD_WHITE);
        actions.setBorder(new EmptyBorder(10, 0, 0, 0));
        actions.add(submit);
        form.add(actions);

        panel.add(form);
        return panel;
    }

