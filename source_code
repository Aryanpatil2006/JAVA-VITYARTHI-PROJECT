        panel.add(form);
        return panel;
    }

    // --------------------------------------------------------- WITHDRAW tab

    private JTextField withdrawAccno, withdrawAmount;
    private JPasswordField withdrawPin;

    private JPanel buildWithdrawPanel() {
        JPanel panel = new JPanel();
        panel.setLayout(new BoxLayout(panel, BoxLayout.Y_AXIS));
        panel.setBackground(CANVAS);
        panel.add(sectionHeader("Withdraw Money", "Requires the account's 4-digit PIN."));

        JPanel form = formCard();
        withdrawAccno = labeledField(form, "Account number");
        withdrawPin = labeledPasswordField(form, "4-digit PIN");
        withdrawAmount = labeledField(form, "Amount to withdraw");

        JButton submit = dangerButton("Withdraw");
        submit.addActionListener(e -> {
            String accno = withdrawAccno.getText().trim();
            String pin = new String(withdrawPin.getPassword()).trim();
            String amountText = withdrawAmount.getText().trim();

            if (accno.isEmpty() || pin.isEmpty() || amountText.isEmpty()) {
                setStatus("Enter account number, PIN, and amount.");
                return;
            }
            Accounting acc = hm.get(accno);
            if (acc == null) {
                setStatus("Account " + accno + " was not found.");
                return;
            }
            if (!acc.hasPin()) {
                setStatus("No PIN set for account " + accno + ". Set one under 'Set PIN' first.");
                return;
            }
            if (!acc.checkPin(pin)) {
                setStatus("Incorrect PIN for account " + accno + ".");
                withdrawPin.setText("");
                return;
            }
            double amount;
            try {
                amount = Double.parseDouble(amountText);
            } catch (NumberFormatException ex) {
                setStatus("Amount must be a number.");
                return;
            }
            if (amount <= 0) {
                setStatus("Amount must be greater than zero.");
                return;
            }
            if (amount > acc.balance) {
                setStatus(String.format("Insufficient balance. Available: %.2f", acc.balance));
                return;
            }

            acc.balance -= amount;
            refreshHomeStats();
            withdrawAmount.setText("");
            withdrawPin.setText("");
            setStatus(String.format("Withdrew %.2f from account %s. New balance: %.2f",
                    amount, accno, acc.balance));
        });

        JPanel actions = new JPanel(new FlowLayout(FlowLayout.LEFT, 0, 0));
        actions.setBackground(CARD_WHITE);
        actions.setBorder(new EmptyBorder(10, 0, 0, 0));
        actions.add(submit);
        form.add(actions);

        panel.add(form);
        return panel;
    }

    // ---------------------------------------------------------- SET PIN tab

    private JTextField setPinAccno;
    private JPasswordField setPinNew, setPinConfirm;

    private JPanel buildSetPinPanel() {
        JPanel panel = new JPanel();
        panel.setLayout(new BoxLayout(panel, BoxLayout.Y_AXIS));
        panel.setBackground(CANVAS);
        panel.add(sectionHeader("Set / Update PIN", "A 4-digit PIN is required before withdrawing."));

        JPanel form = formCard();
        setPinAccno = labeledField(form, "Account number");
        setPinNew = labeledPasswordField(form, "New 4-digit PIN");
        setPinConfirm = labeledPasswordField(form, "Confirm PIN");

        JButton submit = primaryButton("Save PIN");
        submit.addActionListener(e -> {
            String accno = setPinAccno.getText().trim();
            String newPin = new String(setPinNew.getPassword()).trim();
            String confirmPin = new String(setPinConfirm.getPassword()).trim();

            if (accno.isEmpty() || newPin.isEmpty() || confirmPin.isEmpty()) {
                setStatus("Enter account number, new PIN, and confirmation.");
                return;
            }
            Accounting acc = hm.get(accno);
            if (acc == null) {
                setStatus("Account " + accno + " was not found.");
                return;
            }
            if (!newPin.matches("\\d{4}")) {
                setStatus("PIN must be exactly 4 digits.");
                return;
            }
            if (!newPin.equals(confirmPin)) {
                setStatus("PIN and confirmation do not match.");
                return;
            }

            acc.pin = newPin;
            setPinNew.setText("");
            setPinConfirm.setText("");
            setStatus("PIN set for account " + accno + ".");
        });

        JPanel actions = new JPanel(new FlowLayout(FlowLayout.LEFT, 0, 0));
        actions.setBackground(CARD_WHITE);
        actions.setBorder(new EmptyBorder(10, 0, 0, 0));
        actions.add(submit);
        form.add(actions);

        panel.add(form);
        return panel;
    }

