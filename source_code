class Accounting implements Serializable {
    private static final long serialVersionUID = 1L;

    String Accno;
    String Name;
    Double balance;
    String pin; // 4-digit PIN, null until the user sets one

    Accounting() {}

    Accounting(String a, String b, Double c) {
        Accno = a;
        Name = b;
        balance = c;
    }

    boolean hasPin() {
        return pin != null && !pin.isEmpty();
    }

    boolean checkPin(String entered) {
        return hasPin() && pin.equals(entered);
    }

    public String toString() {
        return "Account no.= " + Accno + "\nName= " + Name + "\nBalance= " + balance
                + "\nPIN set= " + (hasPin() ? "Yes" : "No");
    }
}

